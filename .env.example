# ==============================================================================
# CodeArchaeologist Environment Configuration
# ==============================================================================
# NOTE: An API key is 100% OPTIONAL.
# CodeArchaeologist runs its entire deterministic core (AST parsing, multi-tier
# architecture graphs, Git archaeology, TF-IDF vector embeddings, cascading blast radius,
# and historical ML impact prediction) completely OFFLINE without any external API calls.
#
# If you wish to use an external LLM for natural language response generation in the RAG
# assistant, provide ONE of the following API keys:
# ==============================================================================

# Google Gemini API Key (Recommended for high-speed grounded RAG synthesis)
# GEMINI_API_KEY=AIzaSy...

# OpenAI API Key (Alternative external LLM provider)
# OPENAI_API_KEY=sk-...

# Server Port (Default: 8000)
# PORT=8000
